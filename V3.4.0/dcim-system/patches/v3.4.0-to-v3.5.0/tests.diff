+        check(s.status_code == 200, f"实例 B 建连 HTTP {s.status_code}")
+        # iter_lines 不可重入（首个生成器被 GC 会关闭 urllib3 连接）：单生成器跨阶段消费
+        lines = s.iter_lines(decode_unicode=True)
