+        for line in lines:
+            if line and line.startswith("data:") and '"channel":"workorder"' in line.replace(" ", ""):
+                hit = True
+                break
+            if time.time() - t0 > 10:
+                break
+        check(hit, "10s 内未在流上收到 workorder 频道广播帧")
+    return "connected 帧 + workorder 频道广播均正常"
