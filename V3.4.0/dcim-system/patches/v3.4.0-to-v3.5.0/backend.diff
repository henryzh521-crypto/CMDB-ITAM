@@ -0,0 +1,50 @@
+package com.dcim.common.event;
+
+import com.dcim.common.notify.NotificationPort;
+import org.springframework.stereotype.Service;
+
+/**
+ * 统一事件 / 通知门面（v3.5）。
+ *
+ * <p>组合既有 {@link DomainEventPublisher}（Spring 事件 → 事务性发件箱 / Webhook
+ * 投递，语义不变）与 {@link NotificationPort}（站内信，NotificationAdapter 落库后
+ * 自动叠加 SSE 按用户实时推送）。联动链路一处调用即完成
+ * 「领域事件 + 站内信 + 实时推送」三路分发；既有 DomainEventPublisher 调用点不动。
+ */
+@Service
+public class UnifiedEventPublisher {
+    private final DomainEventPublisher events;
+    private final NotificationPort notifications;
+
+    public UnifiedEventPublisher(DomainEventPublisher events, NotificationPort notifications) {
+        this.events = events;
+        this.notifications = notifications;
+    }
+
+    /** 只发领域事件（发件箱 / Webhook / SSE 频道广播）。 */
+    public void publish(DomainEvent event) {
+        this.events.publish(event);
+    }
+
+    /** 只发站内信（落库 + SSE 按用户实时推送）。 */
+    public void notifyUser(String username, String type, String title, String content, String refId) {
+        this.notifications.notifyUser(username, type, title, content, refId);
+    }
+
+    /** 只发给指定角色的站内信（落库 + SSE 按用户实时推送）。 */
+    public void notifyRole(String roleCode, String type, String title, String content, String refId) {
+        this.notifications.notifyRole(roleCode, type, title, content, refId);
+    }
+
+    /** 领域事件 + 给指定用户的站内信（含 SSE 实时推送）。 */
+    public void publishAndNotifyUser(DomainEvent event, String username, String type, String title, String content, String refId) {
+        this.events.publish(event);
+        this.notifications.notifyUser(username, type, title, content, refId);
+    }
+
+    /** 领域事件 + 给指定角色的站内信（含 SSE 实时推送）。 */
+    public void publishAndNotifyRole(DomainEvent event, String roleCode, String type, String title, String content, String refId) {
+        this.events.publish(event);
+        this.notifications.notifyRole(roleCode, type, title, content, refId);
+    }
+}
diff --git a/backend-src/com/dcim/common/sse/RedisSseRelay.java b/backend-src/com/dcim/common/sse/RedisSseRelay.java
new file mode 100644
index 0000000..0609421
--- /dev/null
+++ b/backend-src/com/dcim/common/sse/RedisSseRelay.java
@@ -0,0 +1,64 @@
+package com.dcim.common.sse;
+
+import com.dcim.security.RedisEnabledCondition;
+import com.fasterxml.jackson.core.type.TypeReference;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.io.IOException;
+import java.util.Map;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Conditional;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.data.redis.connection.Message;
+import org.springframework.data.redis.connection.MessageListener;
+import org.springframework.data.redis.connection.RedisConnectionFactory;
+import org.springframework.data.redis.listener.ChannelTopic;
+import org.springframework.data.redis.listener.RedisMessageListenerContainer;
+
+/**
+ * Redis pub/sub → SSE 跨实例转发（v3.5）。
+ *
+ * <p>仅当配置了 Redis（REDIS_HOST 非空，见 {@link RedisEnabledCondition}）时装配；
+ * 订阅 {@link SsePushService#CHANNEL}，把其他实例发布的信封交给
+ * {@link SsePushService#onRelayed} 在本机分发。
+ *
+ * <p>SSE 停用（dcim.sse.enabled=false）时不订阅任何频道 —— 连接本身也建不起来，
+ * 完整回到 3.4 行为（整体回退开关的一部分）。
+ */
+@Configuration(proxyBeanMethods = false)
+@Conditional(RedisEnabledCondition.class)
+public class RedisSseRelay implements MessageListener {
+    private static final Logger log = LoggerFactory.getLogger(RedisSseRelay.class);
+    private final SsePushService pushService;
+    private final ObjectMapper objectMapper;
+    private final boolean sseEnabled;
+
+    public RedisSseRelay(SsePushService pushService, ObjectMapper objectMapper, @Value("${dcim.sse.enabled:true}") boolean sseEnabled) {
+        this.pushService = pushService;
+        this.objectMapper = objectMapper;
+        this.sseEnabled = sseEnabled;
+    }
+
+    @Bean
+    public RedisMessageListenerContainer dcimSseRelayContainer(RedisConnectionFactory factory) {
+        RedisMessageListenerContainer container = new RedisMessageListenerContainer();
+        container.setConnectionFactory(factory);
+        if (this.sseEnabled) {
+            container.addMessageListener(this, new ChannelTopic(SsePushService.CHANNEL));
+            log.info("[sse] 已订阅 Redis 频道 {}（跨实例转发）", SsePushService.CHANNEL);
+        }
+        return container;
+    }
+
+    @Override
+    public void onMessage(Message message, byte[] pattern) {
+        try {
+            Map<String, Object> envelope = this.objectMapper.readValue(message.getBody(), new TypeReference<Map<String, Object>>() {});
+            this.pushService.onRelayed(envelope);
+        } catch (RuntimeException | IOException e) {
+            log.warn("[sse] 跨实例信封解析失败：{}", e.toString());
+        }
+    }
+}
diff --git a/backend-src/com/dcim/common/sse/SseConnectionRegistry.java b/backend-src/com/dcim/common/sse/SseConnectionRegistry.java
new file mode 100644
index 0000000..d6a8309
--- /dev/null
+++ b/backend-src/com/dcim/common/sse/SseConnectionRegistry.java
@@ -0,0 +1,175 @@
+package com.dcim.common.sse;
+
+import com.dcim.common.BusinessException;
+import jakarta.annotation.PostConstruct;
+import jakarta.annotation.PreDestroy;
+import java.io.IOException;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicLong;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Component;
+import org.springframework.web.servlet.mvc.method.annotation.SseEmitter;
+
+/**
+ * SSE 连接注册表（v3.5）。
+ *
+ * <p>每个在线连接对应一个 {@link SseEmitter}，键为 {@code username:connId}
+ * （同一用户可开多个标签页，互不干扰）。超时设 0（生命周期自管），
+ * 由心跳注释帧探测死连接并就地清理。
+ *
+ * <p><b>为什么心跳不用 @Scheduled：</b>ScheduledJobLockAspect 会对所有 @Scheduled
+ * 方法做集群互斥加锁 —— 双实例部署时只有抢到锁的实例能跑心跳，另一实例的连接
+ * 会被中间层按空闲超时掐断。因此这里自建单线程守护 ScheduledExecutorService，
+ * 每个实例独立心跳（各实例只对自己持有的连接负责，无需互斥）。
+ *
+ * <p><b>连接数上限：</b>SseEmitter 是异步长连接，占 fd 与内存，超过上限直接 503，
+ * 前端 EventSource 收到错误后降级为轮询（见通知中心前端实现）。
+ */
+@Component
+public class SseConnectionRegistry {
+    private static final Logger log = LoggerFactory.getLogger(SseConnectionRegistry.class);
+    private final ConcurrentHashMap<String, SseEmitter> emitters = new ConcurrentHashMap<>();
+    private final AtomicLong connSeq = new AtomicLong();
+    private final boolean enabled;
+    private final int maxConnections;
+    private final long heartbeatMs;
+    private ScheduledExecutorService heartbeat;
+
+    public SseConnectionRegistry(
+        @Value("${dcim.sse.enabled:true}") boolean enabled,
+        @Value("${dcim.sse.max-connections-per-instance:200}") int maxConnections,
+        @Value("${dcim.sse.heartbeat-ms:25000}") long heartbeatMs
+    ) {
+        this.enabled = enabled;
+        this.maxConnections = maxConnections;
+        this.heartbeatMs = heartbeatMs;
+    }
+
+    @PostConstruct
+    void start() {
+        if (!this.enabled || this.heartbeatMs <= 0) {
+            return;
+        }
+        this.heartbeat = Executors.newSingleThreadScheduledExecutor(r -> {
+            Thread t = new Thread(r, "sse-heartbeat");
+            t.setDaemon(true);
+            return t;
+        });
+        this.heartbeat.scheduleWithFixedDelay(this::beat, this.heartbeatMs, this.heartbeatMs, TimeUnit.MILLISECONDS);
+        log.info("[sse] 心跳已启动：{}ms，每实例连接上限 {}", this.heartbeatMs, this.maxConnections);
+    }
+
+    @PreDestroy
+    void stop() {
+        if (this.heartbeat != null) {
+            this.heartbeat.shutdownNow();
+        }
+        for (Map.Entry<String, SseEmitter> e : this.emitters.entrySet()) {
+            this.quietComplete(e.getValue());
+        }
+        this.emitters.clear();
+    }
+
+    /** 建立连接：注册 emitter 并立即发送 connected 帧（客户端可据此确认链路可用）。 */
+    public SseEmitter register(String username) {
+        if (!this.enabled) {
+            throw new BusinessException(503, "SSE 推送已停用");
+        } else if (this.emitters.size() >= this.maxConnections) {
+            // 超限 503：前端 EventSource onerror 后降级为轮询（风险对策：fd 耗尽防护）
+            throw new BusinessException(503, "SSE 连接数已达本实例上限（" + this.maxConnections + "），请稍后重试或使用轮询模式");
+        }
+        String key = username + ":" + this.connSeq.incrementAndGet();
+        // 不能用 0（无超时）：Spring 将 0 原样传给 Tomcat 的 ASYNC_SETTIMEOUT，coyote 只对 >0 排期，
+        // 0 被忽略后实际生效容器默认 30s —— async 超时 dispatch 会把 response 置为 errored，
+        // 此后广播 / 心跳对该连接的写入全部失败（连接僵尸化，客户端却毫无感知）。
+        // 显式 24h 兜底：真正的生命周期由 25s 心跳探测 + onTimeout/onError/onCompletion 回调清理。
+        SseEmitter emitter = new SseEmitter(86_400_000L);
+        emitter.onCompletion(() -> this.remove(key, emitter));
+        emitter.onTimeout(() -> this.remove(key, emitter));
+        emitter.onError(t -> this.remove(key, emitter));
+        this.emitters.put(key, emitter);
+        try {
+            emitter.send(SseEmitter.event().name("connected").data(Map.of("ok", true)));
+        } catch (RuntimeException | IOException e) {
+            this.remove(key, emitter);
+            throw new BusinessException(503, "SSE 连接建立失败");
+        }
+        log.debug("[sse] {} 上线，当前 {} 连接", key, this.emitters.size());
+        return emitter;
+    }
+
+    /** 向指定用户的全部本机连接推送，返回送达数；失败的连接就地清理。 */
+    public int sendToUser(String username, Object payload) {
+        if (username == null || username.isBlank()) {
+            return 0;
+        }
+        String prefix = username + ":";
+        int sent = 0;
+        for (Map.Entry<String, SseEmitter> e : this.emitters.entrySet()) {
+            if (e.getKey().startsWith(prefix)) {
+                sent += this.send(e.getKey(), e.getValue(), payload);
+            }
+        }
+        return sent;
+    }
+
+    /** 向本机全部连接广播，返回送达数；失败的连接就地清理。 */
+    public int broadcast(Object payload) {
+        int sent = 0;
+        for (Map.Entry<String, SseEmitter> e : this.emitters.entrySet()) {
+            sent += this.send(e.getKey(), e.getValue(), payload);
+        }
+        return sent;
+    }
+
+    public int count() {
+        return this.emitters.size();
+    }
+
+    private int send(String key, SseEmitter emitter, Object payload) {
+        try {
+            emitter.send(SseEmitter.event().name("message").data(payload));
+            return 1;
+        } catch (RuntimeException | IOException e) {
+            log.debug("[sse] 推送失败，移除连接 {}：{}", key, e.toString());
+            this.remove(key, emitter);
+            return 0;
+        }
+    }
+
+    private void beat() {
+        for (Map.Entry<String, SseEmitter> e : this.emitters.entrySet()) {
+            try {
+                // 注释帧（:ping）：只保活，不产生客户端事件
+                e.getValue().send(SseEmitter.event().comment("ping"));
+            } catch (RuntimeException | IOException ex) {
+                this.remove(e.getKey(), e.getValue());
+            }
+        }
+    }
+
+    private void remove(String key, SseEmitter emitter) {
+        boolean removed = this.emitters.remove(key, emitter);
+        if (removed) {
+            log.debug("[sse] {} 下线，当前 {} 连接", key, this.emitters.size());
+        }
+        this.quietComplete(emitter);
+    }
+
+    private void quietComplete(SseEmitter emitter) {
+        try {
+            emitter.complete();
+        } catch (Exception ignored) {
+            // 必须吞掉一切异常：Spring 6.1 的 AsyncRequestNotUsableException（IOException 子类）
+            // 会以 sneaky-throw 方式从 complete() 逃逸（静态签名不声明，catch RuntimeException 防不住）。
+            // 若放任其逃逸：中断 broadcast 循环（其余连接收不到推送）、污染业务请求线程
+            // （事务已提交却返回 500）、并杀死心跳调度线程（死连接永不清理）。
+        }
+    }
+}
