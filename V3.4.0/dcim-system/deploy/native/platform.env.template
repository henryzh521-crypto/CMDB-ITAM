# /etc/dcim/platform.env —— 原生部署（systemd）后端配置，权限 0600
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=@DB_URL@
SPRING_DATASOURCE_USERNAME=@DB_USER@
SPRING_DATASOURCE_PASSWORD=@DB_PASS@
REDIS_HOST=@REDIS_HOST@
REDIS_PORT=@REDIS_PORT@
REDIS_PASSWORD=@REDIS_PASS@
JWT_SECRET=@JWT_SECRET@
DCIM_CRYPTO_KEY=@CRYPTO_KEY@
# 加密密钥轮换：旧密钥（逗号分隔），启动时自动重加密后可清空
DCIM_CRYPTO_KEY_OLD=
DCIM_AGENT_KEY=@AGENT_KEY@
DCIM_ADMIN_INITIAL_PASSWORD=@ADMIN_PW@
CORS_ORIGINS=@CORS@
# 附件：本地目录（如需对象存储改为 minio 并补充 MINIO_*）
STORAGE_TYPE=local
UPLOAD_DIR=@UPLOAD_DIR@
# GPU 指标：memory（单机内存环形缓冲）/ tdengine（需补充 TDENGINE_URL/USERNAME/PASSWORD）
DCIM_METRICS_STORE=memory
AUDIT_RETAIN_MONTHS=6
RATE_LIMIT_PER_MINUTE=3000
RATE_LIMIT_USER_RPS=20
RATE_LIMIT_USER_BURST=40
RATE_LIMIT_HEAVY_PER_MINUTE=10
LOGIN_MAX_FAIL_PER_ACCOUNT_GLOBAL=30
LOGIN_ACCOUNT_LOCK_MINUTES=15
LOGIN_TRUSTED_IP_DAYS=30
# 数据库连接池（v3.4）：每实例连接上限 / 借连接最长等待（毫秒，超时返回 503）
DB_POOL_MAX=20
DB_POOL_TIMEOUT_MS=10000
# Webhook：原生部署时本机网段常与企业 OA 同网段，默认不封；如需封禁本机网段改为 true
WEBHOOK_BLOCK_LOCAL_SUBNETS=false
# 仅信任本机 nginx 传来的 X-Forwarded-For
DCIM_TRUSTED_PROXIES=127.0.0.0/8,::1/128
# 监控接入令牌（Prometheus 服务发现 / Alertmanager 回调共用）；Prometheus 地址如 http://127.0.0.1:9090
MONITORING_TOKEN=@MONITORING_TOKEN@
PROMETHEUS_URL=
JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError"
# LDAP / AD 统一登录（可选；含括号等特殊字符的值请加双引号）
#LDAP_ENABLED=true
#LDAP_URL=ldaps://dc01.corp.local:636
#LDAP_BASE_DN=DC=corp,DC=local
#LDAP_BIND_DN=svc-dcim@corp.local
#LDAP_BIND_PASSWORD=
#LDAP_USER_FILTER="(&(objectClass=user)(sAMAccountName={0}))"
#LDAP_GROUP_ROLE_MAP="CN=DCIM-Ops,OU=Groups,DC=corp,DC=local=R-OPS"
